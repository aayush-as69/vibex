# Copy this file to .env.local for local setup.
# The SENSOR_API_TOKEN enables the optional local factory sensor agent.
# Generate a private random token; do not commit .env.local.

SENSOR_HOST=127.0.0.1
SENSOR_PORT=4318
SENSOR_API_TOKEN=replace-with-a-private-random-token-at-least-24-characters

# Optional integrations for future releases
# LLM_API_KEY=
# THREAT_INTEL_API_KEY=
