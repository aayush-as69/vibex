# Copy this file to .env.local for local setup.
# The Factory Sensor Agent is optional; leave the token blank to disable it.
# Generate a unique value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never commit .env.local.

SENSOR_HOST=127.0.0.1
SENSOR_PORT=4318
SENSOR_API_TOKEN=

# Optional integrations for future releases
# LLM_API_KEY=
# THREAT_INTEL_API_KEY=
